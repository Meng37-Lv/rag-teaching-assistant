{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "课程知识增强教学助手",
  "mainBinaryName": "课程知识增强教学助手",
  "version": "1.0.0",
  "identifier": "cn.edu.xidian.rag-teaching-assistant",
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "课程知识增强教学助手",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 640,
        "center": true,
        "visible": false,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "category": "Education",
    "shortDescription": "基于课程知识库的教学辅助桌面应用",
    "longDescription": "提供问题优化、答案评价和课程汇报提问功能。",
    "externalBin": ["binaries/desktop-backend"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false,
        "compression": "lzma",
        "startMenuFolder": "课程知识增强教学助手",
        "installerHooks": "./windows/installer-hooks.nsh"
      },
      "wix": {
        "language": "zh-CN"
      }
    }
  }
}
