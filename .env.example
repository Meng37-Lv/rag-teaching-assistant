LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.example.com/v1
LLM_MODEL=your_model_name
LLM_REASONING_EFFORT=high
LLM_ENABLE_THINKING=true
LLM_TIMEOUT_SECONDS=12
RAG_TOP_K=3
RAG_MAX_CONTEXT_CHARS=1800
RAG_MAX_CHUNK_CHARS=600

# Optional public login background image (HTTPS URL or same-origin path).
SCHOOL_AERIAL_IMAGE_URL=

# Public HTTPS web URL used for classroom QR codes.
PUBLIC_WEB_BASE_URL=

# Local PPTX/DOCX -> PDF preview (desktop bundle passes these paths at runtime).
PREVIEW_CONVERTER_PATH=soffice
PREVIEW_FONT_DIR=
PREVIEW_FILE_TIMEOUT_SECONDS=60
PREVIEW_SUBMISSION_TIMEOUT_SECONDS=180
PREVIEW_MAX_CONCURRENCY=1
PREVIEW_CACHE_TTL_SECONDS=86400
PREVIEW_CONVERTER_VERSION=libreoffice-26.2.6
